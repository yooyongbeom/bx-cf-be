<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bwg.channel.backend.productsvc.repository.mybatis.mapper.ProductMapper">

    <!-- 상품 DTO 매핑 정보 -->
    <resultMap id="productDtoResult" type="ProductResDto">
        <!-- productId: 상품 ID -->
        <id     property="productId"   column="product_id"/>
        <!-- productNm: 상품명 -->
        <result property="productNm"   column="product_nm"/>
        <!-- productDesc: 상품 설명 -->
        <result property="productDesc" column="product_desc"/>
        <!-- price: 상품 가격 -->
        <result property="price"       column="price"/>
        <!-- stockQty: 재고 수량 -->
        <result property="stockQty"    column="stock_qty"/>
        <!-- useYn: 사용 여부 -->
        <result property="useYn"       column="use_yn"/>
    </resultMap>

    <!-- 상품 목록 조건 조회 -->
    <select id="findAll" parameterType="ApiRequest"
            resultMap="productDtoResult">
        <![CDATA[
        /* productsvc.ProductMapper.findAll(상품 목록 조회) */
        SELECT
            product_id      /* 상품 ID */
            ,product_nm     /* 상품명 */
            ,product_desc   /* 상품 설명 */
            ,price          /* 상품 가격 */
            ,stock_qty      /* 재고 수량 */
            ,use_yn         /* 사용 여부 */
        FROM products
        ]]>
        <!-- 동적 검색 조건 -->
        <where>
            <!-- 사용 여부 조건 -->
            <if test="filter != null and filter.useYn != null and filter.useYn != ''">
                <![CDATA[
                AND use_yn = #{filter.useYn}
                ]]>
            </if>
            <!-- 상품명 부분 일치 조건 -->
            <if test="data != null and data.productNm != null and data.productNm != ''">
                <![CDATA[
                AND product_nm LIKE '%' || #{data.productNm} || '%'
                ]]>
            </if>
            <!-- 통합 검색어 조건: searchType이 없으면 상품명/설명을 함께 검색한다. -->
            <if test="filter != null and filter.keyword != null and filter.keyword != ''">
                <choose>
                    <when test="filter.searchType == 'productDesc'">
                        <![CDATA[
                        AND product_desc LIKE '%' || #{filter.keyword} || '%'
                        ]]>
                    </when>
                    <otherwise>
                        <![CDATA[
                        AND (
                            product_nm LIKE '%' || #{filter.keyword} || '%'
                            OR product_desc LIKE '%' || #{filter.keyword} || '%'
                        )
                        ]]>
                    </otherwise>
                </choose>
            </if>
        </where>
        <!-- 정렬 조건: 허용된 컬럼/방향만 분기 처리한다. -->
        <choose>
            <when test="sort != null and sort.sort == 'productId,asc'">
                <![CDATA[
                ORDER BY product_id ASC
                ]]>
            </when>
            <when test="sort != null and sort.sort == 'productId,desc'">
                <![CDATA[
                ORDER BY product_id DESC
                ]]>
            </when>
            <when test="sort != null and sort.sort == 'productNm,asc'">
                <![CDATA[
                ORDER BY product_nm ASC, product_id DESC
                ]]>
            </when>
            <when test="sort != null and sort.sort == 'productNm,desc'">
                <![CDATA[
                ORDER BY product_nm DESC, product_id DESC
                ]]>
            </when>
            <when test="sort != null and sort.sort == 'price,asc'">
                <![CDATA[
                ORDER BY price ASC, product_id DESC
                ]]>
            </when>
            <when test="sort != null and sort.sort == 'price,desc'">
                <![CDATA[
                ORDER BY price DESC, product_id DESC
                ]]>
            </when>
            <when test="sort != null and sort.sort == 'stockQty,asc'">
                <![CDATA[
                ORDER BY stock_qty ASC, product_id DESC
                ]]>
            </when>
            <when test="sort != null and sort.sort == 'stockQty,desc'">
                <![CDATA[
                ORDER BY stock_qty DESC, product_id DESC
                ]]>
            </when>
            <otherwise>
                <![CDATA[
                ORDER BY product_id DESC
                ]]>
            </otherwise>
        </choose>
        <if test="pagination != null and pagination.size != null and pagination.size > 0">
            <![CDATA[
            LIMIT #{pagination.size}
            ]]>
        </if>
        <if test="pagination != null and pagination.offset != null">
            <![CDATA[
            OFFSET #{pagination.offset}
            ]]>
        </if>
    </select>

    <!-- 상품 ID 단건 조회 -->
    <select id="findById" resultMap="productDtoResult">
        <![CDATA[
        /* productsvc.ProductMapper.findById(상품 단건 조회) */
        SELECT
            product_id      /* 상품 ID */
            ,product_nm     /* 상품명 */
            ,product_desc   /* 상품 설명 */
            ,price          /* 상품 가격 */
            ,stock_qty      /* 재고 수량 */
            ,use_yn         /* 사용 여부 */
        FROM products
        WHERE product_id = #{productId}
        ]]>
    </select>

</mapper>
