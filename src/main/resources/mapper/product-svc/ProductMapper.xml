<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bwg.channel.backend.productsvc.repository.mybatis.mapper.ProductMapper">

    <!-- 상품 DTO 매핑 정보 -->
    <resultMap id="productDtoResult" type="com.bwg.channel.backend.productsvc.domain.dto.ProductDto">
        <!-- productId: 상품 ID -->
        <id     property="productId"   column="product_id"/>
        <!-- productNm: 상품명 -->
        <result property="productNm"   column="product_nm"/>
        <!-- productDesc: 상품 설명 -->
        <result property="productDesc" column="product_desc"/>
        <!-- price: 상품 가격 -->
        <result property="price"       column="price"/>
        <!-- stockQty: 재고 수량 -->
        <result property="stockQty"    column="stock_qty"/>
        <!-- useYn: 사용 여부 -->
        <result property="useYn"       column="use_yn"/>
    </resultMap>

    <!-- 상품 목록 조건 조회 -->
    <select id="findAll" parameterType="com.bwg.channel.backend.productsvc.domain.dto.ProductDto"
            resultMap="productDtoResult">
        <![CDATA[
        /* productsvc.ProductMapper.findAll(상품 목록 조회) */
        SELECT
            product_id      /* 상품 ID */
            ,product_nm     /* 상품명 */
            ,product_desc   /* 상품 설명 */
            ,price          /* 상품 가격 */
            ,stock_qty      /* 재고 수량 */
            ,use_yn         /* 사용 여부 */
        FROM products
        ]]>
        <!-- 동적 검색 조건 -->
        <where>
            <!-- 사용 여부 조건 -->
            <if test="useYn != null and useYn != ''">
                <![CDATA[
                AND use_yn = #{useYn}
                ]]>
            </if>
            <!-- 상품명 부분 일치 조건 -->
            <if test="productNm != null and productNm != ''">
                <![CDATA[
                AND product_nm LIKE '%' || #{productNm} || '%'
                ]]>
            </if>
        </where>
        <![CDATA[
        ORDER BY product_id DESC
        ]]>
    </select>

    <!-- 상품 ID 단건 조회 -->
    <select id="findById" resultMap="productDtoResult">
        <![CDATA[
        /* productsvc.ProductMapper.findById(상품 단건 조회) */
        SELECT
            product_id      /* 상품 ID */
            ,product_nm     /* 상품명 */
            ,product_desc   /* 상품 설명 */
            ,price          /* 상품 가격 */
            ,stock_qty      /* 재고 수량 */
            ,use_yn         /* 사용 여부 */
        FROM products
        WHERE product_id = #{productId}
        ]]>
    </select>

</mapper>
