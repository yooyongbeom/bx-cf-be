{
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot-DiscoverySvcApplication<discovery-svc>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.bwg.channel.backend.discovery.DiscoverySvcApplication",
            "projectName": "discovery-svc",
            "args": "--spring.profiles.active=local",
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": " -Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.port=54721 -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Dspring.jmx.enabled=true -Djava.rmi.server.hostname=localhost -Dspring.application.admin.enabled=true -Dspring.boot.project.name=discovery-svc"
        },
